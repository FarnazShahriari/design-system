{
  "shape": "package",
  "pkg": "@farnazshahriari/design-system",
  "projectId": "9fd677da-db35-449e-9eb5-3692e99d1b19",
  "globalName": "CalmBold",
  "srcDir": "src",
  "tsconfig": "tsconfig.json",
  "cssEntry": ".ds-compiled.css",
  "extraFonts": [
    "../../.design-sync/theme/fonts/fonts.css"
  ],
  "guidelinesGlob": [
    "skills/**/*.md"
  ],
  "extraEntries": [
    "../../.design-sync/process-shim.mjs"
  ],
  "overrides": {
    "Container": {
      "viewport": "1600x1000"
    },
    "ProjectGrid": {
      "viewport": "1200x1100"
    },
    "Card": {
      "cardMode": "column"
    },
    "Checkbox": {
      "cardMode": "column"
    },
    "PaginationEllipsis": {
      "cardMode": "column"
    },
    "Progress": {
      "cardMode": "column"
    },
    "RadioGroup": {
      "cardMode": "column"
    },
    "Separator": {
      "cardMode": "column"
    },
    "Skeleton": {
      "cardMode": "column"
    },
    "Switch": {
      "cardMode": "column"
    },
    "Tabs": {
      "cardMode": "column"
    },
    "Textarea": {
      "cardMode": "column"
    },
    "Dialog": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Select": {
      "cardMode": "single",
      "primaryStory": "Open"
    },
    "Tooltip": {
      "cardMode": "single",
      "primaryStory": "Sides"
    }
  },
  "readmeHeader": ".design-sync/conventions.md"
}
