{
  "name": "@farnazshahriari/design-system",
  "version": "1.0.0",
  "description": "A restrained, editorial design system: tokens, 52 components, layout primitives and motion.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/FarnazShahriari/design-system.git",
    "directory": "packages/design-system"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "sideEffects": [
    "*.css"
  ],
  "files": [
    "src",
    "theme.css",
    "skills",
    "README.md",
    "CHANGELOG.md"
  ],
