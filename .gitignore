# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
.ds-sync/
ds-bundle/
.design-sync/.cache/
# ...except the grade verdicts. design-sync normally keeps verification state
# out of git because it travels via the uploaded project's _ds_sync.json. This
# repo's build machine cannot upload (cloud session, no design-system auth), so
# that channel does not exist and the grades would be redone from scratch on the
# machine that can. They are content-hashed against the authored previews and
# the preview-affecting config — both committed — so a stale one clears itself.
!.design-sync/.cache/
!.design-sync/.cache/review/
!.design-sync/.cache/review/*.json
.design-sync/learnings/
.design-sync/node_modules
packages/design-system/.ds-compiled.css
packages/design-system/types/
packages/design-system/index.d.ts
